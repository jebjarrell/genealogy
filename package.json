{
  "name": "genealogy-graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Genealogy Knowledge Graph Viewer — load a GEDCOM file and explore it as an interactive, ego-centric graph with pedigree-collapse detection.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @genealogy/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @genealogy/core test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
