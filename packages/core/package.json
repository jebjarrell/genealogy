{
  "name": "@genealogy/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure-TypeScript genealogy core: GEDCOM parsing, normalized model, graph algorithms, pedigree-collapse detection. No DOM, no network, no Node-only APIs.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "read-gedcom": "0.3.2"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
