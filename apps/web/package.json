{
  "name": "@genealogy/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser app: in-browser GEDCOM load, React Flow ego-network rendering, detail/search/collapse panels.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@genealogy/core": "workspace:*",
    "@genealogy/geo": "workspace:*",
    "@xyflow/react": "^12.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/dagre": "^0.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
